# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=ecs_iot
POSTGRES_USER=ecs_iot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para compartir el dashboard fuera de tu red con un túnel de Cloudflare
# (ver README.md > "Compartir el dashboard fuera de tu red"), usa en su lugar:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Bootstraps un usuario admin (rol Global) en el primer `migrate` (ver backend/Dockerfile / docker-compose.yml)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- MQTT / Mosquitto ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecs
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TOPIC_PREFIX=ecs

# --- Puertos publicados en el host (útiles si ya tienes otro proyecto usando
# los puertos por defecto 8000/1883 en esta misma máquina) ---
WEB_HOST_PORT=8000
MOSQUITTO_HOST_PORT=1883

# --- Simulator only ---
# Tokens de los dispositivos demo de calidad de aire (3 ESP32 + VDF del PLC), en formato
# slug:token,slug:token,... Son tokens de DEMOSTRACIÓN: `python manage.py seed_calidad_aire`
# crea los dispositivos usando exactamente estos valores. Cámbialos por otros si expones
# el broker fuera de tu red. Sin un token que coincida, el listener pone en cuarentena
# las lecturas del simulador como UnregisteredReading.
SIMULATOR_DEVICE_TOKENS=esp32-ch4:demo-token-esp32-ch4-change-me,esp32-co2:demo-token-esp32-co2-change-me,esp32-pm10:demo-token-esp32-pm10-change-me,plc-ventilador:demo-token-plc-ventilador-change-me

# --- Google Maps (geolocalización de dispositivos y puestas a tierra) ---
# Deja vacío para desarrollar sin mapa (se muestra un aviso en su lugar).
# Ver README.md > "Geolocalización" para cómo generar una key.
GOOGLE_MAPS_API_KEY=
